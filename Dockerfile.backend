FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CHROMEDRIVER_PATH=/usr/bin/chromedriver

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium chromium-driver libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY policypilot ./policypilot
COPY scripts ./scripts
COPY PolicyPilot_Logo.png ./PolicyPilot_Logo.png
RUN mkdir -p /app/data

EXPOSE 8000
CMD ["uvicorn", "policypilot.main:app", "--host", "0.0.0.0", "--port", "8000"]
