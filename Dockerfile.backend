FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN python -c "from chromadb.utils.embedding_functions import DefaultEmbeddingFunction; DefaultEmbeddingFunction()(['PolicyPilot model warmup'])"

COPY policypilot ./policypilot
COPY scripts ./scripts
COPY PolicyPilot_Logo.png ./PolicyPilot_Logo.png
RUN mkdir -p /app/data

EXPOSE 8000
CMD ["sh", "-c", "uvicorn policypilot.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
